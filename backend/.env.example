# ── LLM ──
# 必填：填入你自己的 API Key
LLM_API_KEY=
# OpenAI 兼容接口地址
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 服务 ──
HOST=127.0.0.1
PORT=8002

# ── 数据库 ──
# 留空则使用 backend/data/database/college_secretary.db
DATABASE_URL=

# ── OCR ──
OCR_ENABLED=true

# ── 安全 ──
# 本地令牌：首次启动自动生成并写入 backend/data/local_token.txt
# 显式配置后优先使用该值
LOCAL_TOKEN=
ENABLE_TOKEN=true
CORS_ORIGINS=
RATE_LIMIT_PER_MIN=60

# ── 演示模式 ──
DEMO_MODE=false
